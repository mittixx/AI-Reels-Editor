# Скопируйте этот файл в .env. Реальные ключи в репозиторий и ZIP не добавляйте.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
TRANSCRIPTION_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
HYPERFRAMES_BIN=hyperframes
MOTION_CANVAS_BIN=npm
LOG_LEVEL=INFO
