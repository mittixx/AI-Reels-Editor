{
  "$defs": {
    "VisualIntent": {
      "enum": [
        "subtitle",
        "hook_text",
        "b_roll",
        "screen_recording",
        "screenshot",
        "logo",
        "text_accent",
        "simple_zoom",
        "transition",
        "simple_transition",
        "cta",
        "animated_stat",
        "animated_counter",
        "comparison",
        "process_flow",
        "timeline",
        "quote",
        "code_animation",
        "feature_list",
        "product_feature",
        "before_after",
        "callout",
        "chart",
        "diagram",
        "complex_capcut_effect",
        "beauty_adjustment",
        "manual_visual_fix"
      ],
      "title": "VisualIntent",
      "type": "string"
    },
    "VisualItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/VisualIntent"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "confidence": {
          "default": "HIGH",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "intent",
        "start",
        "duration"
      ],
      "title": "VisualItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "output_duration": {
      "exclusiveMinimum": 0,
      "title": "Output Duration",
      "type": "number"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/VisualItem"
      },
      "title": "Items",
      "type": "array"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "output_duration",
    "items",
    "profile"
  ],
  "title": "VisualPlan",
  "type": "object"
}
