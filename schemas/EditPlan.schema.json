{
  "$defs": {
    "TimeRange": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        },
        "action": {
          "default": "keep",
          "enum": [
            "keep",
            "cut",
            "shorten",
            "reorder",
            "move_hook",
            "review"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "keep_ranges": {
      "items": {
        "$ref": "#/$defs/TimeRange"
      },
      "minItems": 1,
      "title": "Keep Ranges",
      "type": "array"
    },
    "removed_ranges": {
      "items": {
        "$ref": "#/$defs/TimeRange"
      },
      "title": "Removed Ranges",
      "type": "array"
    },
    "reordered": {
      "default": false,
      "title": "Reordered",
      "type": "boolean"
    },
    "moved_hook": {
      "default": false,
      "title": "Moved Hook",
      "type": "boolean"
    },
    "estimated_duration": {
      "exclusiveMinimum": 0,
      "title": "Estimated Duration",
      "type": "number"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "keep_ranges",
    "estimated_duration"
  ],
  "title": "EditPlan",
  "type": "object"
}
