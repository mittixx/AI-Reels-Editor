{
  "$defs": {
    "TranscriptSegment": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "TranscriptWord": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        }
      },
      "required": [
        "text",
        "start",
        "end"
      ],
      "title": "TranscriptWord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "source_duration": {
      "exclusiveMinimum": 0,
      "title": "Source Duration",
      "type": "number"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "first_speech": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Speech"
    },
    "last_speech": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Speech"
    },
    "transcript_end": {
      "minimum": 0,
      "title": "Transcript End",
      "type": "number"
    },
    "audio_end": {
      "minimum": 0,
      "title": "Audio End",
      "type": "number"
    },
    "coverage_complete": {
      "title": "Coverage Complete",
      "type": "boolean"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "provider_metadata": {
      "additionalProperties": true,
      "title": "Provider Metadata",
      "type": "object"
    }
  },
  "required": [
    "project_id",
    "language",
    "source_duration",
    "segments",
    "transcript_end",
    "audio_end",
    "coverage_complete",
    "provider"
  ],
  "title": "Transcript",
  "type": "object"
}
