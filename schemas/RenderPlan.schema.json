    "schema_version": {
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "width": {
      "default": 1080,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 1920,
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "exclusiveMinimum": 0,
      "maximum": 240,
      "title": "Fps",
      "type": "number"
    },
    "fps_rational": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fps Rational"
    },
    "duration": {
      "exclusiveMinimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/RenderOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "master_renderer": {
      "const": "hyperframes",
      "default": "hyperframes",
      "title": "Master Renderer",
      "type": "string"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "cache_key": {
      "title": "Cache Key",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "fps",
    "duration",
    "operations",
    "output_path",
    "cache_key"
